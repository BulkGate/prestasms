<script async src="{{ url.get("widget/message/send/#{token}/?config=init_widget_message_send") }}"></script>
<script>
    function init_widget_message_send(widget) {
        widget.setOptionsChunk({
            props: {
                recipients: [
                    {{ variables | json_encode | raw }}
                ]
            }
        })
    }
</script>

<div class="card mt-2" data-role="message-card">
    <div class="card-header">
        <h3 class="card-header-title">
            BulkGate SMS
        </h3>
    </div>
    <div class="card-body">
        <gate-send-message><button class="btn btn-action"><i class="material-icons">send_to_mobile</i> {{ 'Send message' | trans }}</button></gate-send-message>
    </div>
</div>
